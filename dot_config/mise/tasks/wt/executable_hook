#!/usr/bin/env bash
#MISE description=".herdr/worktree.json のフックをチェックアウトのルートで実行する (wt:create などが使う。手動の再実行にも使える)"
#MISE dir="{{cwd}}"
#USAGE arg "<name>" help="フック名 (post_create / post_sync / pre_serve / pre_remove)"
#USAGE arg "[path]" help="対象のチェックアウト (省略時はカレント)"
set -euo pipefail
source "$(dirname "$(realpath "$0")")/../../lib/wt.sh"
wt_load "${usage_path:-.}"
wt_require_config
[[ " $WT_HOOKS " == *" $usage_name "* ]] || wt_die "未知のフックです: $usage_name ($WT_HOOKS)"
wt_export_env
wt_run_hook "$usage_name"
