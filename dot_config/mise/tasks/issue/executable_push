#!/usr/bin/env bash
#MISE description="下書き <Issue のディレクトリ>/issue.md で Issue 本文を更新し、GitHub の本文と一致するか確かめて「Issue更新済」にする (--diff は更新せず差分だけ表示)"
#MISE dir="{{cwd}}"
#USAGE arg "<number>" help="GitHub の Issue 番号"
#USAGE flag "--diff" help="更新せず、GitHub の現在の本文と下書きの差分だけを表示する"
set -euo pipefail
source "$(dirname "$(realpath "$0")")/../../lib/issue.sh"
issue_load
n="$usage_number"
dir="$(issue_dir "$n")" || issue_die "Issue #$n のディレクトリがありません"
f="$dir/issue.md"
[ -f "$f" ] || issue_die "下書きがありません: $f"
# 末尾の改行と CRLF の違いは無視して比べる
remote() { printf '%s\n' "$(gh issue view "$n" --json body --jq .body | tr -d '\r')"; }
local_() { printf '%s\n' "$(tr -d '\r' < "$f")"; }
if [ -n "${usage_diff:-}" ]; then
  diff -u --label "GitHub #$n" --label "$f" <(remote) <(local_) && echo "差分なし"
  exit 0
fi
gh issue edit "$n" --body-file "$f" >/dev/null
diff -u --label "GitHub #$n" --label "$f" <(remote) <(local_) || issue_die "更新後の本文が下書きと一致しません"
# 再現まで (未着手・再現済) なら「Issue更新済」に進める。それより先の状態は戻さない
case "$(issue_status_of "$dir")" in 未着手|再現済) issue_mark "$n" Issue更新済 >/dev/null ;; esac
echo "更新完了 (下書きと一致): $(gh issue view "$n" --json url --jq .url)"
