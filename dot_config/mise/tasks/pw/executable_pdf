#!/usr/bin/env bash
#MISE description="PDF を pdf.js で描画し、ページごとの PNG とテキストを出力する (エビデンス用。poppler が無くても動く)"
#MISE dir="{{cwd}}"
#USAGE arg "<pdf>" help="PDF ファイル"
#USAGE arg "[out]" help="出力先のプレフィックス (省略時は PDF と同じ場所・同じ名前)。<out>-p1.png, <out>-p2.png ... と <out>.txt を作る"
set -euo pipefail
pdf="$(realpath "$usage_pdf")"
out="${usage_out:-}"
[ -n "$out" ] && out="$(realpath -m -- "$out")" || out="${pdf%.pdf}"
# mise pw はルートに移って実行するので、出力先は絶対パスにしておく
tmp="$(mktemp -d)"
port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')"
cleanup(){ mise pw -s=pdf close >/dev/null 2>&1 || true; [ -n "${srv:-}" ] && kill "$srv" 2>/dev/null || true; rm -rf "$tmp"; }
trap cleanup EXIT
cp "$pdf" "$tmp/doc.pdf"
# カレントの .playwright/cli.config.json に左右されないよう、chromium を使う設定を明示する
cat > "$tmp/cli.config.json" <<'JSON'
{ "browser": { "browserName": "chromium", "launchOptions": { "channel": "chromium" } } }
JSON
cat > "$tmp/index.html" <<'HTML'
<!doctype html><html><head><meta charset="utf-8"><style>body{margin:0;background:#fff}canvas{display:block;margin-bottom:8px}</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script></head><body><div id="pages"></div>
<script>
pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
(async()=>{try{const pdf=await pdfjsLib.getDocument({url:'doc.pdf',cMapUrl:'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/cmaps/',cMapPacked:true}).promise;
const texts=[];for(let i=1;i<=pdf.numPages;i++){const p=await pdf.getPage(i);const v=p.getViewport({scale:2});const c=document.createElement('canvas');c.width=v.width;c.height=v.height;document.getElementById('pages').appendChild(c);await p.render({canvasContext:c.getContext('2d'),viewport:v}).promise;const t=await p.getTextContent();texts.push(t.items.map(x=>x.str).join(' '));}
window.pdfText=texts;window.numPages=pdf.numPages;}catch(e){window.pdfError=String(e);}window.done=true;})();
</script></body></html>
HTML
(cd "$tmp" && exec python3 -m http.server "$port" --bind 127.0.0.1 >/dev/null 2>&1) & srv=$!
sleep 1
mise pw -s=pdf open --config="$tmp/cli.config.json" "http://127.0.0.1:$port/index.html" >/dev/null
for _ in $(seq 1 30); do
  [ "$(mise pw -s=pdf eval '() => String(!!window.done)' 2>/dev/null | sed -n 2p)" = '"true"' ] && break
  sleep 1
done
err="$(mise pw -s=pdf eval '() => window.pdfError || ""' | sed -n 2p)"
[ "$err" = '""' ] || { echo "PDF の描画に失敗しました: $err" >&2; exit 1; }
n="$(mise pw -s=pdf eval '() => String(window.numPages)' | sed -n 2p | tr -d '"')"
for i in $(seq 1 "$n"); do
  mise pw -s=pdf screenshot "canvas >> nth=$((i-1))" --filename="$out-p$i.png" >/dev/null
  echo "page $i: $out-p$i.png"
done
mise pw -s=pdf eval '() => window.pdfText.map((t,i) => `--- page ${i+1} ---\n${t}`).join("\n")' | sed -n 2p | python3 -c 'import json,sys; print(json.loads(sys.stdin.read()))' > "$out.txt"
echo "text: $out.txt"
