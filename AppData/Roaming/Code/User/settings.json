{
  "editor.fontSize": 16,
  "workbench.startupEditor": "none",
  "editor.wordWrap": "on",
  "editor.wrappingIndent": "indent",
  "editor.guides.bracketPairs": "active",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "htmltagwrap.tag": "div",
  "files.trimTrailingWhitespace": true,
  "editor.autoClosingBrackets": "always",
  "editor.tabCompletion": "on",
  "editor.trimAutoWhitespace": false,
  "files.trimFinalNewlines": true,
  "workbench.editor.labelFormat": "short",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.explorerKind": "external",
  "files.eol": "\n",
  "workbench.colorTheme": "Netlify Dark Theme",
  "editor.colorDecoratorsActivatedOn": "hover",
  "editor.defaultColorDecorators": "auto",
  "color-highlight.markerType": "dot-before",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "RictyDiminished Nerd Font",
  "better-todo-tree.highlights.defaultHighlight": {
    "gutterIcon": true,
  },
  "better-todo-tree.general.tags": [
    "FIXME",
    "NOTE",
    "MEMO",
    "TODO",
    "CHECK",
    "[ ]",
    "[x]",
  ],
  "better-todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check-circle-fill",
      "foreground": "#fb923c",
      "iconColour": "#fb923c",
    },
    "FIXME": {
      "icon": "flame",
      "foreground": "#facc15",
      "iconColour": "#facc15",
    },
    "NOTE": {
      "icon": "paintbrush",
      "foreground": "#00BFFF",
      "iconColour": "#00BFFF",
    },
    "MEMO": {
      "icon": "paintbrush",
      "foreground": "#00BFFF",
      "iconColour": "#00BFFF",
    },
    "CHECK": {
      "icon": "plus-circle",
      "foreground": "#a3e635",
      "iconColour": "#a3e635",
    },
    "[ ]": {
      "background": "#ff000070",
    },
    "[x]": {
      "background": "#00ff0070",
    },
  },
  "[php]": {
    "editor.tabSize": 4,
  },
  "[blade]": {
    "editor.tabSize": 4,
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
  },
  "files.associations": {
    "*.css": "postcss",
    "*.gs": "javascript",
  },
  "debug.console.fontFamily": "RictyDiminished Nerd Font",
  "gitlens.blame.fontFamily": "RictyDiminished Nerd Font",
  "editor.screenReaderAnnounceInlineSuggestion": false,
  "terminal.integrated.fontWeight": "500",
  "debug.confirmOnExit": "always",
  "files.insertFinalNewline": true,
  "window.closeWhenEmpty": true,
  "files.exclude": {
    "**/.git": false,
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true,
    "scminput": false,
    "typescript": true,
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "debug.javascript.enableNetworkView": true,
  "remote.autoForwardPortsSource": "hybrid",
  "github.gitProtocol": "ssh",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "gitlens.views.scm.grouped.views": {
    "commits": false,
    "branches": false,
    "remotes": false,
    "stashes": false,
    "tags": false,
    "worktrees": false,
    "contributors": false,
    "fileHistory": false,
    "repositories": false,
    "searchAndCompare": false,
    "launchpad": false,
  },
  "git.blame.statusBarItem.enabled": true,
  "github.copilot.chat.localeOverride": "ja",
  "js/ts.inlayHints.variableTypes.enabled": true,
  "js/ts.inlayHints.propertyDeclarationTypes.enabled": true,
