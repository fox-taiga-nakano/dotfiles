    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
  },
  "githubPullRequests.pullBranch": "never",
  "geminicodeassist.project": "gen-lang-client-0338870555",
  "csv-edit.fontSizeInPx": 14,
