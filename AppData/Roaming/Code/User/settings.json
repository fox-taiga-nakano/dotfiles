  "gitlens.currentLine.fontFamily": "RictyDiminished Nerd Font",
  "chat.mcp.autostart": "newAndOutdated",
  "coderabbit.agentType": "Claude Code",
  "github.copilot.chat.alternateGptPrompt.enabled": true,
