README.md

# Runtime files generated inside exact externals; keep them from being removed.
.oh-my-zsh/cache
.oh-my-zsh/log
.oh-my-zsh/**/*.zwc

# マシン固有・非公開の設定 (VPN 名など)。公開リポジトリに入れない
.config/mise/conf.d/local.toml

# エージェントの作業メモ (tasks/todo.md・tasks/lessons.md)。ホームに展開しない
tasks

# Windows 側のホーム (/mnt/c/Users/<user>) を展開先にしたとき (mise win ...) は許可リスト方式で
# Windows の設定だけを対象にし、Linux 用のファイル・scripts・externals を展開しない
{{- if hasPrefix "/mnt/c/" .chezmoi.destDir }}
*
.*
.*/**
!.wslconfig
!AppData/**
!Documents/**
{{- else }}
.wslconfig
AppData
AppData/**
Documents
Documents/**
{{- end }}
